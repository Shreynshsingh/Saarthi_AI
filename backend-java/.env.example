# Saarthi AI Backend - Environment Variables
# Copy this file to .env and fill in real values. NEVER commit .env to GitHub.
# Usage (local dev): set -a; source .env; set +a; ./mvnw spring-boot:run

# PostgreSQL (must match docker-compose.yml for local dev)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=saarthi_db
DB_USERNAME=saarthi_user
DB_PASSWORD=saarthi_password

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT - MUST be at least 32 characters. Generate with: openssl rand -base64 64
JWT_SECRET=change-me-to-a-random-secret-at-least-32-characters-long

# Groq - REQUIRED since Module 2 (Llama brain + Whisper). Get a free key at console.groq.com
GROQ_API_KEY=gsk_change-me-to-your-groq-key

# Python sidecar (TTS + sign classification) - ai-service-python on port 8000
PYTHON_SERVICE_URL=http://localhost:8000
# Sign-language input kill switch: false disables /predict-sign calls (voice/text unaffected)
SIGN_ENABLED=true
# MCP memory server (Module 9): internal FastMCP on port 8001, never public.
# MCP_ENABLED=false reverts MemoryAgent to direct JPA (demo-day safety net).
MCP_SERVER_URL=http://localhost:8001
MCP_ENABLED=true

# Frontend origin allowed by CORS (exact match, no trailing slash)
FRONTEND_URL=http://localhost:3000

# Avatar provider: did (live lip-sync) or static (photo + voice fallback)
AVATAR_PROVIDER=did
# D-ID Streaming API key from https://studio.d-id.com - blank disables live avatar
DID_API_KEY=
# Public base URL for uploaded photos (D-ID cloud must reach it; use a tunnel domain on local dev)
# AVATAR_PUBLIC_BASE_URL=http://localhost:8080
