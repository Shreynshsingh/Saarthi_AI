# Saarthi AI - RENDER (Java backend) environment template.
# Set these in Render Dashboard -> Service -> Environment. NEVER commit real values.
# Mirrors 17_DEPLOYMENT_GUIDE.md Section 13 (master list). Local defaults live in
# .env.example; every variable below MUST be set on Render except where noted.

# Supabase PostgreSQL (Step 1) - JDBC connection string parts
DB_HOST=db.xxxxxxxxxxxx.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USERNAME=postgres
DB_PASSWORD=your_supabase_password
# Supabase requires TLS on JDBC
DB_JDBC_PARAMS=?sslmode=require

# Upstash Redis (Step 2) - TLS required
REDIS_HOST=your-upstash-host.upstash.io
REDIS_PORT=6379
REDIS_PASSWORD=your_upstash_password
REDIS_SSL_ENABLED=true

# Secrets - paste real keys, never placeholders
GROQ_API_KEY=gsk_paste-rotated-key-here
DID_API_KEY=paste-did-key-here
JWT_SECRET=paste-random-secret-at-least-32-chars

# Service wiring (Steps 3-7)
# Temporary FRONTEND_URL until Vercel deploys (Step 7 updates it to the Vercel URL)
FRONTEND_URL=http://localhost:3000
PYTHON_SERVICE_URL=https://saarthi-sign.onrender.com
MCP_SERVER_URL=http://saarthi-mcp:8001
MCP_ENABLED=true
SIGN_ENABLED=true

# D-ID cloud fetches mentor photos from here: must be the PUBLIC Render backend URL
AVATAR_PUBLIC_BASE_URL=https://saarthi-api.onrender.com

# Render injects PORT itself (usually 10000); listed here so the template is complete
PORT=10000
