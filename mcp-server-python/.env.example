# Saarthi MCP server - LOCAL secrets. NEVER commit this file.
# Local dev reuses the app credentials; production MUST use a dedicated
# read-only PostgreSQL role (SELECT on users, mood_logs, conversations,
# messages only - no INSERT/UPDATE/DELETE). All queries in db.py are SELECT.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=saarthi_db
DB_USERNAME=saarthi_user
DB_PASSWORD=saarthi_password
